# ---- Runtime ----
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
# MongoDB Atlas SRV string (needs a replica set for transactions — Atlas has one).
# Local only: MONGODB_URI=memory starts an in-memory replica set (data is lost on restart).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/campusfind
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,https://vspark.learn2earntech.com
TRUST_PROXY=1

# ---- Auth ----
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
REFRESH_TOKEN_PEPPER=replace-with-openssl-rand-hex-32
ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=
BCRYPT_ROUNDS=12

# ---- University configuration ----
UNIVERSITY_NAME=Green Valley State University
ALLOWED_EMAIL_DOMAINS=campusfind.edu.pk
# minLat,minLng,maxLat,maxLng
CAMPUS_BOUNDS=31.4900,74.3000,31.5500,74.4000

# ---- Private bucket storage ----
STORAGE_DRIVER=local
STORAGE_ROOT=./storage
FILE_LINK_SECRET=replace-with-openssl-rand-hex-32
FILE_LINK_TTL_SECONDS=60
# S3-compatible (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- External API (OpenStreetMap Nominatim, no key) ----
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=CampusFind/1.0 (university lost-and-found; https://github.com/MalikHamza007/campusfind-backend)
NOMINATIM_TIMEOUT_MS=6000
GEO_CACHE_TTL_HOURS=72

# ---- Seed (first admin + seeded student accounts) ----
ADMIN_EMAIL=admin@campusfind.edu.pk
ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=
# set to true to allow `npm run seed` to wipe data when NODE_ENV=production
SEED_ALLOW_RESET=false
